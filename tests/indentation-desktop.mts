import { _electron as electron, expect } from 'playwright/test';
import assert from 'node:assert/strict';
import {mkdtemp,mkdir,readFile,writeFile} from 'node:fs/promises';
import path from 'node:path';
import os from 'node:os';
const data=await mkdtemp(path.join(os.tmpdir(),'open-typora-indent-'));
const qa=process.env.OPEN_TYPORA_QA_DIR || path.join(data,'evidence');await mkdir(qa,{recursive:true});
const file=path.join(data,'Indent 中文.md'), sourceFile=path.join(data,'Source 中文.md');
const original='# Shortcut indentation\n\n- alpha\n- beta\n\n```js\nconst first = 1;\nconst second = 2;\n```\n';
await writeFile(file,original);await writeFile(sourceFile,'alpha\nbeta\n');
const env: Record<string, string>={...process.env,OPEN_TYPORA_DATA_DIR:path.join(data,'profile')};delete env.ELECTRON_RUN_AS_NODE;delete env.OPEN_TYPORA_DEV_URL;
let app!: import("playwright").ElectronApplication, page!: import("playwright").Page;const errors: string[]=[],checks: string[]=[];const mod=process.platform==='darwin'?'Meta':'Control';
try{
 app=await electron.launch({...(process.env.OPEN_TYPORA_EXECUTABLE?{executablePath:process.env.OPEN_TYPORA_EXECUTABLE,args:[]}:{args:[process.cwd()]}),env,timeout:30000});
 page=await app.firstWindow();page.on('pageerror',error=>errors.push(error.message));
 await expect(page.getByRole('tab',{name:'欢迎.md',exact:true})).toBeVisible({timeout:20000});
 const menu=async (name: string)=>{await page.getByRole('button',{name:'更多操作',exact:true}).click();await page.getByRole('menuitem',{name,exact:true}).click();};
 const open=async (file: string)=>{await app.evaluate(({dialog},file: string)=>{dialog.showOpenDialog=async()=>({canceled:false,filePaths:[file]});},file);await menu('打开文件');await expect(page.getByRole('tab',{name:path.basename(file),exact:true})).toHaveAttribute('aria-selected','true');};
 await open(file);
 const surface=page.locator('.document-editor[data-active="true"]'),root=surface.locator('.rich-document');
 await root.evaluate(element=>{const walker=document.createTreeWalker(element,NodeFilter.SHOW_TEXT);let node,from,to;while((node=walker.nextNode())){if((node as Text).data==='alpha')from=node;if((node as Text).data==='beta')to=node;}if(!from||!to)throw Error('Missing list selection');element.focus();getSelection()!.setBaseAndExtent(from,0,to,(to as Text).length);document.dispatchEvent(new Event('selectionchange'));});
 const list=original.replace('- alpha\n- beta','  - alpha\n  - beta');
 await page.keyboard.press(`${mod}+BracketLeft`);await expect.poll(()=>readFile(file,'utf8')).toBe(list);
 await page.keyboard.press(`${mod}+BracketRight`);await expect.poll(()=>readFile(file,'utf8')).toBe(original);
 await page.keyboard.press(`${mod}+z`);await expect.poll(()=>readFile(file,'utf8')).toBe(list);
 await page.keyboard.press(`${mod}+z`);await expect.poll(()=>readFile(file,'utf8')).toBe(original);
 checks.push('Bracket shortcuts indent/outdent selected list rows and undo each operation once.');
 await root.locator('.fence-body').click();const code=root.locator('.fence-editing .cm-content');await expect(code).toBeVisible();await code.press(`${mod}+a`);
 const indentedCode=original.replace('const first = 1;\nconst second = 2;','  const first = 1;\n  const second = 2;');
 await page.keyboard.press(`${mod}+BracketLeft`);await expect.poll(()=>readFile(file,'utf8')).toBe(indentedCode);
 await page.keyboard.press(`${mod}+BracketRight`);await expect.poll(()=>readFile(file,'utf8')).toBe(original);
 await page.keyboard.press(`${mod}+z`);await expect.poll(()=>readFile(file,'utf8')).toBe(indentedCode);
 await page.keyboard.press(`${mod}+z`);await expect.poll(()=>readFile(file,'utf8')).toBe(original);
 await menu('增加缩进');await expect.poll(()=>readFile(file,'utf8')).toBe(indentedCode);
 await menu('减少缩进');await expect.poll(()=>readFile(file,'utf8')).toBe(original);
 checks.push('Bracket shortcuts indent/outdent all selected code lines without changing fence delimiters; undo remains separate.');
 await open(sourceFile);await page.getByRole('button',{name:'源码',exact:true}).click();
 const source=surface.locator('.source-surface .cm-content');await expect(source).toBeVisible();await source.press(`${mod}+a`);
 await page.keyboard.press(`${mod}+BracketLeft`);await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('  alpha\n  beta\n');
 await page.keyboard.press(`${mod}+BracketRight`);await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('alpha\nbeta\n');
 await page.keyboard.press(`${mod}+z`);await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('  alpha\n  beta\n');
 await page.keyboard.press(`${mod}+Shift+z`);await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('alpha\nbeta\n');
 await menu('增加缩进');await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('  alpha\n  beta\n');
 await menu('减少缩进');await expect.poll(()=>readFile(sourceFile,'utf8')).toBe('alpha\nbeta\n');
 checks.push('Source-mode shortcuts and menu commands indent/outdent selected lines and preserve undo/redo.');
 await menu('插件管理…');await page.getByRole('checkbox',{name:'启用只读模式',exact:true}).check();
 await page.getByRole('dialog',{name:'插件管理',exact:true}).getByRole('button',{name:'完成',exact:true}).click();
 await menu('增加缩进');await expect(page.locator('.toast')).toContainText('只读模式已开启');
 assert.equal(await readFile(sourceFile,'utf8'),'alpha\nbeta\n');
 checks.push('Read-only mode still refuses indentation after enabling the commands in source mode.');
 assert.deepEqual(errors,[]);await page.screenshot({path:path.join(qa,'indentation.png')});
 await writeFile(path.join(qa,'indentation-results.json'),JSON.stringify({platform:process.platform,checks,errors},null,2));for(const check of checks)console.log('PASS: '+check);
}catch(error){await page?.screenshot({path:path.join(qa,'indentation-failure.png')}).catch(()=>{});throw error;}
finally{if(app){await app.evaluate(({app})=>app.exit(0)).catch(()=>{});await app.close().catch(()=>{});}}
