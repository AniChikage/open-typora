import { _electron as electron, expect } from "playwright/test";
import assert from "node:assert/strict";
import { mkdtemp, writeFile, mkdir, symlink } from "node:fs/promises";
import { createHash } from "node:crypto";
import os from "node:os";
import path from "node:path";
const directory = await mkdtemp(path.join(os.tmpdir(), "open-typora-features-"));
const file = path.join(directory, "功能验收.md"), original = "# 功能验收\n\n普通文字。\n\n[toc]\n\n## 另一个标题\n\n脚注[^fn1]。\n\n[^fn1]: 注释内容\n\n==高亮== H~2~O X^2^ :smile: <u>下划线</u>\n";
await writeFile(file, original);
const outside = await mkdtemp(path.join(os.tmpdir(), "open-typora-link-outside-"));
await writeFile(path.join(outside, "outside.md"), "# Outside grant\n");
await symlink(path.join(outside, "outside.md"), path.join(directory, "escaping.md"));
await mkdir(path.join(directory, "子目录")); await writeFile(path.join(directory, "子目录", "另一页.md"), "# 另一页\n\n文件树与快速打开验收\n");
await writeFile(path.join(directory, "session.json"), JSON.stringify({ version: 1, folder: directory, activeId: "fixture", documents: [{ id: "fixture", path: file, name: "功能验收.md", content: original, savedContent: original, diskHash: createHash("sha256").update(original).digest("hex"), bom: false, lineEnding: "\n" }] }));
const env: Record<string, string> = { ...process.env, OPEN_TYPORA_DATA_DIR: directory }; delete env.OPEN_TYPORA_DEV_URL; delete env.ELECTRON_RUN_AS_NODE;
const application = await electron.launch({ args: [process.cwd()], env });
const page = await application.firstWindow(), errors: string[] = [], passed: string[] = [], qa = process.env.OPEN_TYPORA_QA_DIR || "/tmp/open-typora-features-qa";
page.on("pageerror", error => errors.push(error.message));
const rich = page.locator(".rich-document"), source = page.locator(".source-surface .cm-content");
async function mode(rendered: boolean) { const button = page.locator(".source-toggle"); if (((await button.getAttribute("aria-pressed")) === "true") === rendered) await button.click(); await expect(rendered ? rich : source).toBeVisible(); }
async function menu(label: string) { await page.getByRole("button", { name: "更多操作" }).click(); await page.getByRole("menuitem", { name: label, exact: true }).click(); }
async function text() { await mode(false); return (await source.locator(".cm-line").allTextContents()).join("\n"); }
try {
  await expect(rich.locator(".markdown-toc a")).toHaveCount(2);
  const rejectedLink = await page.evaluate(async () => { const result = await window.desktop!.openDocumentLink("fixture", "escaping.md"); return result.ok ? "" : result.error; });
  assert.match(rejectedLink, /当前文档目录之外/);
  passed.push("relative document links reject symlinks outside the document directory");
  await expect(rich.locator("mark")).toHaveText("高亮");
  await expect(rich.locator(".footnote-reference a")).toHaveText("1");
  await rich.locator(".markdown-toc a").last().click();
  await page.keyboard.type("x");
  assert.match(await text(), /## x另一个标题/);
  await mode(true); await rich.press("ControlOrMeta+z");
  assert.equal(await text(), original);
  passed.push("TOC navigation targets the heading text and its edit is undoable");
  await mode(true); await rich.locator("p").filter({ hasText: "普通文字。" }).click();
  await page.keyboard.press("ControlOrMeta+2");
  await expect(rich.getByRole("heading", { name: "普通文字。", exact: true })).toBeVisible();
  assert.ok((await text()).includes("## 普通文字。"));
  await mode(true); await rich.press("ControlOrMeta+z");
  passed.push("heading shortcut changes the actual paragraph source and remains undoable");
  await menu("插入表格…");
  const tableDialog = page.getByRole("dialog", { name: "插入表格", exact: true });
  await tableDialog.getByLabel("行数（含表头）").fill("4"); await tableDialog.getByLabel("列数").fill("3");
  await tableDialog.getByRole("button", { name: "插入", exact: true }).click();
  await expect(rich.locator("table tr")).toHaveCount(4);
  await expect(rich.locator("table th")).toHaveCount(3);
  await rich.locator("table td").first().click(); await page.keyboard.type("cell");
  assert.ok((await text()).includes("cell")); await mode(true);
  passed.push("table dialog creates requested dimensions with editable cells");
  await page.keyboard.press("F8"); await expect(page.locator(".app-shell")).toHaveClass(/focus-mode/);
  const opacity = await rich.locator("[data-cid]:not(.is-active)").first().evaluate(element => getComputedStyle(element).opacity);
  assert.equal(opacity, "0.3"); await page.keyboard.press("F8");
  await page.keyboard.press("F9"); await expect(page.locator(".app-shell")).toHaveClass(/typewriter-mode/);
  await expect.poll(() => rich.evaluate(element => { const rect = getSelection()!.getRangeAt(0).getBoundingClientRect(), bounds = element.parentElement!.getBoundingClientRect(); return Math.abs(rect.top - bounds.top - bounds.height / 2); })).toBeLessThan(25);
  await page.keyboard.press("F9");
  passed.push("F8 dims inactive blocks and F9 toggles typewriter scrolling");
  await page.keyboard.press("ControlOrMeta+,");
  const preferences = page.getByRole("dialog", { name: "偏好设置", exact: true });
  await preferences.getByLabel("高亮：==文字==").uncheck();
  await expect(rich.locator("mark")).toHaveCount(0);
  await preferences.getByLabel("高亮：==文字==").check();
  await expect(rich.locator("mark")).toHaveCount(1);
  await preferences.getByLabel("正文字号").fill("20");
  assert.equal(await rich.evaluate(element => getComputedStyle(element).fontSize), "20px");
  await preferences.getByLabel("主题", { exact: true }).selectOption("dark");
  await mkdir(qa, { recursive: true }); await page.screenshot({ path: path.join(qa, "preferences-dark.png") });
  await preferences.getByLabel("主题", { exact: true }).selectOption("light");
  await preferences.getByLabel("正文字号").fill("16"); await preferences.getByRole("button", { name: "完成" }).click();
  passed.push("preferences change rendering without changing source and apply font/theme live");
  const currentText = await text(); assert.ok(currentText.includes("==高亮==")); await mode(true);
  await page.keyboard.press("ControlOrMeta+Shift+o");
  const quick = page.getByRole("dialog", { name: "快速打开", exact: true });
  await expect(quick.getByRole("combobox")).toBeFocused();
  await quick.getByRole("combobox").fill("功能"); await page.keyboard.press("Enter");
  await expect(quick).toHaveCount(0); await expect(rich).toBeVisible();
  passed.push("quick open supports immediate typing and keyboard selection");
  await page.keyboard.press("ControlOrMeta+Shift+o"); await page.getByRole("combobox").fill("另一页"); await page.keyboard.press("Enter");
  await expect(page.getByRole("heading", { name: "另一页", exact: true })).toBeVisible();
  await page.keyboard.press("ControlOrMeta+Control+3");
  await expect(page.getByRole("tree", { name: "文件树", exact: true })).toBeVisible();
  await expect(page.getByRole("tree").getByRole("button", { name: "另一页.md", exact: true })).toBeVisible();
  passed.push("quick open loads an unopened nested file and the tree expands its directory");
  await page.getByRole("button", { name: "切换侧栏内容" }).click(); await page.getByRole("menuitemradio", { name: "文件", exact: true }).click();
  await page.getByRole("button", { name: "关闭 另一页.md", exact: true }).click();
  await page.keyboard.press("ControlOrMeta+Shift+t"); await expect(page.getByRole("heading", { name: "另一页", exact: true })).toBeVisible();
  passed.push("closing and reopening a file restores the actual document");
  await page.screenshot({ path: path.join(qa, "features-desktop.png") });
  assert.deepEqual(errors, []); passed.push("no renderer errors");
  await writeFile(path.join(qa, "features-results.json"), JSON.stringify({ passed, errors, directory }, null, 2));
  console.log(JSON.stringify({ passed, errors, directory }, null, 2));
} finally { await application.close(); }
