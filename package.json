{
  "name": "open-typora",
  "version": "0.1.1",
  "description": "A local Markdown writing space with live rendering and lossless source editing.",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186",
    "dev:app": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "package:mac": "npm run build && node scripts/icon.mjs && electron-builder --mac dir",
    "install:app": "npm run package:mac && node scripts/install.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.0",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/streamparser": "6.0.0",
    "@codemirror/view": "6.43.14",
    "@fontsource/open-sans": "5.3.0",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.0",
    "lucide-react": "1.56.0",
    "markdown-it": "15.0.2",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.opentypora.desktop",
    "productName": "Open Typora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "identity": null,
      "icon": "build/icon.icns"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ]
  },
  "allowScripts": {
    "electron": true
  }
}
